{
  "builds": [
    {
      "src": "dist/server.cjs",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["dist/**"]
      }
    }
  ],
  "routes": [
    { "src": "/blog", "dest": "/dist/server.cjs" },
    { "src": "/blog/(.*)", "dest": "/dist/server.cjs" },
    { "src": "/sitemap.xml", "dest": "/dist/server.cjs" },
    { "src": "/robots.txt", "dest": "/dist/server.cjs" },
    { "src": "/((?!blog|sitemap.xml|robots.txt|api/).*)", "dest": "/index.html" }
  ]
}
