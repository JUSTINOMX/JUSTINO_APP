{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "rewrites": [
    { "source": "/blog", "destination": "/server" },
    { "source": "/blog/(.*)", "destination": "/server" },
    { "source": "/sitemap.xml", "destination": "/server" },
    { "source": "/robots.txt", "destination": "/server" }
  ]
}
